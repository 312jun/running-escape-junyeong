# 로컬 개발 (.env)
GEMINI_API_KEY=여기에_Gemini_API_키

# Google 지도 (화면 메인 + 도보 길찾기)
# Google Cloud → Maps JavaScript API, Directions API 사용 설정
# 브라우저 제한: http://127.0.0.1:5173/*  / 배포 도메인
GOOGLE_MAPS_API_KEY=여기에_Google_Maps_API_키
# VITE_GOOGLE_MAPS_API_KEY=  (없어도 GOOGLE_MAPS_API_KEY를 화면에 씁니다)

# Vercel 배포 시
# Project → Settings → Environment Variables
# GEMINI_API_KEY
# GOOGLE_MAPS_API_KEY
# (.env 파일은 git에 올리지 마세요)
